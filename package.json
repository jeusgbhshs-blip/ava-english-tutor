{
  "name": "ava-english-tutor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ava — AI 数字人英语老师：实时语音对话、口语跟读评分、单词闯关",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js --open",
    "dev": "node server.js",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:ui": "node test/ui.mjs",
    "build:ios:web": "node scripts/build-ios-web.mjs",
    "ios:sync": "npm run build:ios:web && cap sync ios",
    "ios:open": "cap open ios",
    "ios:verify": "node scripts/verify-ios.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
